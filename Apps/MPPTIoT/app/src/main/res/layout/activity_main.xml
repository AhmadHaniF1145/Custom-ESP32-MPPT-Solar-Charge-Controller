<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="460dp"
        android:layout_height="100dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:gravity="center_horizontal"
            android:text="MPPT Solar Charge Controller IoT"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="#040303"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:gravity="center_horizontal"
            android:text="Ahmad Hanif Abiyyu Khrisna"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="#040303"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:gravity="center_horizontal"
            android:text="2122500031"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="#040303"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="230dp"
        android:layout_height="460dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/linearLayout2"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout"
        app:layout_constraintVertical_bias="0.108">

        <TextView
            android:id="@+id/textView43"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_horizontal"
            android:text="PV Power"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/powerInput"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_horizontal"
            android:text="0" />



        <TextView
            android:id="@+id/textView38"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_horizontal"
            android:text="PV Voltage"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voltageInput"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_horizontal"
            android:text="0" />

        <TextView
            android:id="@+id/textView28"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_horizontal"
            android:text="PV Current"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/currentInput"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_horizontal"
            android:text="0" />

        <TextView
            android:id="@+id/textView23"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_horizontal"
            android:text="Energy Harvested"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView24"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_horizontal"
            android:text="0" />

        <TextView
            android:id="@+id/textView31"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_horizontal"
            android:text="Temperature"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/temperature"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_horizontal"
            android:text="0" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="230dp"
        android:layout_height="460dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/linearLayout3"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout"
        app:layout_constraintVertical_bias="0.108">

        <TextView
            android:id="@+id/textView45"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_horizontal"
            android:text="Battery Percent "
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/batteryPercent"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_horizontal"
            android:text="0" />

        <TextView
            android:id="@+id/textView41"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_horizontal"
            android:text="Battery Voltage"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voltageOutput"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_horizontal"
            android:text="0" />

        <TextView
            android:id="@+id/textView33"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_horizontal"
            android:text="Battery Current"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/currentOutput"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_horizontal"
            android:text="0" />

        <TextView
            android:id="@+id/textView37"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_horizontal"
            android:text="Energy Saving"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/electricalPrice"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_horizontal"
            android:text="0" />

        <LinearLayout
            android:layout_width="201dp"
            android:layout_height="39dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView"
                android:layout_width="43dp"
                android:layout_height="33dp"
                android:layout_weight="1"
                android:text="CHG"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="43dp"
                android:layout_height="33dp"
                android:layout_weight="1"
                android:text="FULL"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:layout_editor_absoluteX="210dp"
                tools:layout_editor_absoluteY="610dp" />

            <TextView
                android:id="@+id/textView7"
                android:layout_width="43dp"
                android:layout_height="33dp"
                android:layout_weight="1"
                android:text="LOW"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:layout_editor_absoluteX="210dp"
                tools:layout_editor_absoluteY="610dp" />

            <TextView
                android:id="@+id/textView8"
                android:layout_width="43dp"
                android:layout_height="33dp"
                android:layout_weight="1"
                android:text=" PV"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:layout_editor_absoluteX="210dp"
                tools:layout_editor_absoluteY="610dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="202dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/LED1"
                android:layout_width="62dp"
                android:layout_height="45dp"
                android:layout_gravity="center|center_horizontal|center_vertical"
                android:layout_weight="1"
                android:buttonTint="#FFEB3B"
                android:clickable="false"
                android:gravity="center|center_vertical" />

            <RadioButton
                android:id="@+id/LED2"
                android:layout_width="62dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:buttonTint="#FFEB3B"
                android:clickable="false"
                android:gravity="center_vertical" />

            <RadioButton
                android:id="@+id/LED3"
                android:layout_width="62dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:buttonTint="#FFEB3B"
                android:checked="false"
                android:clickable="false"
                android:drawableTint="#FFEB3B"
                android:gravity="center_vertical"
                android:textColor="#FFEB3B" />

            <RadioButton
                android:id="@+id/LED4"
                style="@style/Widget.AppCompat.CompoundButton.RadioButton"
                android:layout_width="62dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:buttonTint="#FFEB3B"
                android:clickable="false"
                android:gravity="center_vertical" />
        </LinearLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>